#!/bin/bash
# shellcheck source-path=SCRIPTDIR
#
# Deploy an instance from THIS node's borg archive onto a PEER node.
#
#   zk2-send NAME PEER                  newest archive NAME@* -> PEER
#   zk2-send NAME PEER --archive A      a given archive
#   zk2-send NAME PEER --as PROBE       under another name, without the address
#   zk2-send NAME PEER --force          replace an existing instance on PEER
#   zk2-send --dry-run NAME PEER        show, do nothing
#
# PEER is the peer's name in the fleet - an ssh alias set up by
# zk2-ssh-config.
#
# How: here, borg extract into a temporary ZFS dataset, and the live
# instance's configuration from Incus; then tar with xattrs and ACLs over ssh
# into "zk2-restore stdin NAME" on the peer, which creates the instance,
# unpacks it, applies the configuration, takes the address from ITS restore
# map and starts it. So the peer needs a line for NAME in its restore.conf.
#
# This node reads the archive with its own key and passphrase; neither
# travels. The peer only gets files.
#
# Not "borg export-tar", although it writes to a pipe with no intermediate
# space: in borg 1.4 it drops xattrs and ACLs ("a lossy conversion"), and
# file capabilities would be gone without a word. borg extract keeps them,
# tar --xattrs --acls carries them. The price is space: the root is unpacked
# here in full, into SEND_POOL (node.conf, default ZFS_POOL), and the dataset
# is destroyed whatever happens.

# shellcheck source=zk2-lib
. "$(dirname "$(readlink -f "$0")")/zk2-lib"

DRY_RUN=0; FORCE=0; ARCHIVE_SET=""; AS_NAME=""; POSITIONAL=()
# Options over the whole line, as in zk2-restore: "NAME PEER --as PROBE" is
# the documented form, and a lost --as means replacing the working instance.
while [ $# -gt 0 ]; do
    case "$1" in
        --dry-run) DRY_RUN=1; shift ;;
        --force)   FORCE=1; shift ;;
        --archive) ARCHIVE_SET=${2:?--archive needs an archive name}; shift 2 ;;
        --as)      AS_NAME=${2:?--as needs an instance name}; shift 2 ;;
        -*) zk2_die "unknown option: $1" ;;
        *) POSITIONAL+=("$1"); shift ;;
    esac
done
[ "${#POSITIONAL[@]}" = 2 ] || zk2_die "usage: zk2-send NAME PEER [--archive A] [--as PROBE] [--force] [--dry-run]"
NAME=${POSITIONAL[0]} PEER=${POSITIONAL[1]}
TARGET=${AS_NAME:-$NAME}

zk2_require_root
zk2_require_cmd borg zfs tar ssh incus base64
zk2_load_node
zk2_borg_env
SEND_POOL=${SEND_POOL:-${ZFS_POOL:-tank}}
# stdin closed for everything but the pipe: ssh without -n would eat it.
exec </dev/null

REMOTE_ARGS=()
[ "$FORCE" = 0 ] || REMOTE_ARGS+=(--force)
[ -z "$AS_NAME" ] || REMOTE_ARGS+=(--as "$AS_NAME")
peer() { ssh -o BatchMode=yes "$PEER" "$@"; }

# The configuration travels with the root: limits, swap, autostart and root
# size live in the Incus database, and an instance created from a base image
# would come up with the memory of the whole node. Taken from the LIVE
# instance (the archive does not carry it); if the instance is gone here,
# only the root travels, and that is said aloud. base64 survives ssh and the
# remote shell whatever the values contain.
CONF_B64=""
if zk2_ct_exists "$NAME"; then
    CONF_B64=$(incus query "/1.0/instances/${NAME}" </dev/null 2>/dev/null | base64 -w0 || true)
fi
if [ -n "$CONF_B64" ]; then REMOTE_ARGS+=(--config-b64 "$CONF_B64")
else zk2_warn "no instance ${NAME} here - only the root travels, set the limits on ${PEER} by hand"; fi

# Checks BEFORE unpacking, which can take minutes.
peer true || zk2_die "no ssh to ${PEER} (zk2-ssh-config)"
zpool list "${SEND_POOL%%/*}" >/dev/null 2>&1 || zk2_die "no pool ${SEND_POOL} to unpack into (SEND_POOL in node.conf)"
if peer "incus info '${TARGET}' >/dev/null 2>&1"; then
    [ "$FORCE" = 1 ] || zk2_die "${PEER} already has ${TARGET} - --force replaces it"
    zk2_warn "${PEER} has ${TARGET}, it will be replaced (--force)"
fi
# The peer's restore map is checked by its zk2-restore - but only after the
# whole root was unpacked here. Asked up front with a dry run there; its "DRY
# RUN" line belongs to this check, not to zk2-send.
zk2_log "${PEER}: will it take ${NAME}? (a dry run of zk2-restore there)"
peer "/usr/local/sbin/zk2-restore --dry-run stdin '${NAME}' ${REMOTE_ARGS[*]:-}" </dev/null \
    || zk2_die "${PEER} will not take ${NAME} (no line in its restore.conf?)"

if [ -n "$ARCHIVE_SET" ]; then
    archive=$ARCHIVE_SET
    borg list --glob-archives "$archive" --format '{archive}{NL}' 2>/dev/null | grep -qxF -- "$archive" \
        || zk2_die "no archive ${archive} (zk2-archives ${NAME})"
else
    archive=$(borg list --glob-archives "${NAME}@*" --last 1 --format '{archive}' 2>/dev/null || true)
    [ -n "$archive" ] || zk2_die "no archives ${NAME}@* (zk2-archives ${NAME})"
fi
zk2_log "== ${NAME} -> ${PEER}:${TARGET}, archive ${archive}"

if [ "$DRY_RUN" = 1 ]; then
    show=${REMOTE_ARGS[*]:-}
    [ -z "$CONF_B64" ] || show=${show/${CONF_B64}/[instance configuration, ${#CONF_B64} bytes]}
    zk2_log "  borg extract into ${SEND_POOL}/zk2-send/..., tar | ssh ${PEER} zk2-restore stdin ${NAME} ${show}"
    zk2_warn "DRY RUN: nothing done"
    exit 0
fi

t0=$(date +%s)
DS="${SEND_POOL}/zk2-send/${NAME}-$$"
MNT="/var/lib/zk2-send/${NAME}-$$"
cleanup() { zfs destroy -r "$DS" 2>/dev/null || true; rmdir "$MNT" 2>/dev/null || true; }
trap cleanup EXIT
zfs list "${SEND_POOL}/zk2-send" >/dev/null 2>&1 || zfs create -o mountpoint=none "${SEND_POOL}/zk2-send"
mkdir -p "$MNT"
zfs create -o mountpoint="$MNT" "$DS"

# --lock-wait: the nightly run may hold the repository.
(cd "$MNT" && borg extract --lock-wait 600 --numeric-ids "::${archive}") || zk2_die "borg extract failed"
zk2_ok "  unpacked in $(( $(date +%s) - t0 )) s, $(du -sh "$MNT" | cut -f1)"

# --xattrs-include='*': GNU tar takes user.* only by default; security.capability
# and system.posix_acl_* are needed. --sparse keeps holes in logs and databases.
t1=$(date +%s)
tar -c -f - -C "$MNT" --numeric-owner --sparse --xattrs --xattrs-include='*' --acls . \
    | ssh -o BatchMode=yes "$PEER" "/usr/local/sbin/zk2-restore stdin '${NAME}' ${REMOTE_ARGS[*]:-}" \
    || zk2_die "transfer or receiving failed - see the output of ${PEER} above"
zk2_ok "${NAME} deployed on ${PEER} as ${TARGET}: transfer $(( $(date +%s) - t1 )) s, total $(( $(date +%s) - t0 )) s"
