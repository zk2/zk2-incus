# shellcheck shell=bash
#
# Shared helpers for zk2 node tools. Sourced, not executed:
#
#   . "$(dirname "$(readlink -f "$0")")/zk2-lib"
#
# It turns on `set -euo pipefail` for the calling script on purpose: a failed
# step must stop the run instead of letting the next step work on its
# half-done result.
#
# Tools that run on a bare node before anything of ours is installed (the node
# build) do not use this file and must stay self-contained.

set -euo pipefail

# --help for every command, BEFORE any check: "must be run as root" or
# "missing commands: incus" is no answer to someone reading about a command
# on the workstation. A sourced file sees the caller's arguments. The help
# text is the header comment of the calling script, from its second line to
# the first line that is not a comment, shellcheck directives left out - one
# source, no line numbers to keep in sync.
zk2_help() {
    awk 'NR == 1 { next } /^#/ { if ($0 ~ /^# shellcheck /) next; sub(/^# ?/, ""); if (!s && $0 == "") next; s = 1; print; next } { exit }' "$1"
}
for _zk2_a in "$@"; do
    case "$_zk2_a" in -h|--help) zk2_help "$0"; exit 0 ;; esac
done
unset _zk2_a

ZK2_RED=$'\033[0;31m'; ZK2_GREEN=$'\033[0;32m'; ZK2_YELLOW=$'\033[1;33m'; ZK2_NC=$'\033[0m'

zk2_log()  { printf '%s %s\n'     "$(date '+%F %T')" "$*" >&2; }
zk2_ok()   { printf '%s %s%s%s\n' "$(date '+%F %T')" "$ZK2_GREEN"  "$*" "$ZK2_NC" >&2; }
zk2_warn() { printf '%s %s%s%s\n' "$(date '+%F %T')" "$ZK2_YELLOW" "$*" "$ZK2_NC" >&2; }
zk2_err()  { printf '%s %s%s%s\n' "$(date '+%F %T')" "$ZK2_RED"    "$*" "$ZK2_NC" >&2; }
zk2_die()  { zk2_err "$*"; exit 1; }

zk2_require_root() { [ "$(id -u)" = 0 ] || zk2_die "must be run as root"; }

zk2_require_cmd() {
    local c missing=""
    for c in "$@"; do
        command -v "$c" >/dev/null 2>&1 || missing="${missing} ${c}"
    done
    [ -z "$missing" ] || zk2_die "missing commands:${missing}"
}

# --------------------------------------------------------------------------
# Configuration
# --------------------------------------------------------------------------

ZK2_CONF_DIR=${ZK2_CONF_DIR:-/etc/zk2}
ZK2_NODE_CONF=${ZK2_NODE_CONF:-${ZK2_CONF_DIR}/node.conf}
ZK2_ENV=${ZK2_ENV:-${ZK2_CONF_DIR}/zk2-env}

# node.conf: required by most tools, so a missing file is fatal.
zk2_load_node() {
    [ -r "$ZK2_NODE_CONF" ] || zk2_die "no ${ZK2_NODE_CONF} (deploy the node with zk2-deploy)"
    # shellcheck source=/dev/null
    . "$ZK2_NODE_CONF"
}

# zk2-env: secrets. zk2_load_env VAR... requires the file and the variables;
# zk2_try_env loads it when it is there and says nothing otherwise, for
# tools that have plenty to do without secrets and report what they skipped.
zk2_load_env() {
    local v
    [ -r "$ZK2_ENV" ] || zk2_die "no ${ZK2_ENV}"
    # shellcheck source=/dev/null
    . "$ZK2_ENV"
    for v in "$@"; do
        [ -n "${!v:-}" ] || zk2_die "${v} is not set in ${ZK2_ENV}"
    done
}

zk2_try_env() {
    # shellcheck source=/dev/null
    [ -r "$ZK2_ENV" ] && . "$ZK2_ENV"
    return 0
}

zk2_version() { cat "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../VERSION" 2>/dev/null || echo unknown; }

# --------------------------------------------------------------------------
# Mail
# --------------------------------------------------------------------------

# What sends mail is looked up, not hardcoded: Debian 13 has no ssmtp any
# more, msmtp took its place, and a hardcoded path silently turned the nightly
# mail into a line in a log nobody reads. All of these accept -t.
zk2_mta() {
    local c
    for c in /usr/sbin/sendmail /usr/bin/msmtp /usr/sbin/ssmtp; do
        [ -x "$c" ] && { printf '%s' "$c"; return 0; }
    done
    return 1
}

# zk2_mail SUBJECT - plain text body on stdin, to ZK2_EMAIL (zk2-env) or root.
#
# Returns non-zero when the mail did not go out or there is nothing to send
# it with. The caller must then print the report itself: a report that went
# nowhere looks exactly like "nothing to report".
zk2_mail() {
    local mta subject=$1
    if ! mta=$(zk2_mta); then
        zk2_warn "mail not sent: no sendmail, msmtp or ssmtp"
        return 1
    fi
    {
        printf 'To: %s\n' "${ZK2_EMAIL:-root}"
        printf 'Subject: %s\n' "$subject"
        printf 'MIME-Version: 1.0\nContent-Type: text/plain; charset=UTF-8\n\n'
        cat
    } | "$mta" -t || { zk2_warn "sending through ${mta} failed"; return 1; }
}

# --------------------------------------------------------------------------
# Incus
# --------------------------------------------------------------------------
#
# Every "incus exec" takes stdin. Inside a loop that reads a file or a
# process substitution it eats the rest of the input, the loop ends quietly
# and the script reports success having done part of the work. Hence
# </dev/null on every incus exec, here and in the callers.

zk2_ct_names()   { incus list --format csv -c n </dev/null 2>/dev/null; }
zk2_ct_exists()  { incus info "$1" </dev/null >/dev/null 2>&1; }
# Status from "incus info", not "incus list": list takes a name PREFIX, so
# "incus list web" also returns web-db, and three lines are not one state.
zk2_ct_running() { [ "$(incus info "$1" </dev/null 2>/dev/null | awk '/^Status:/ { print $2; exit }')" = RUNNING ]; }

# zk2_storage NAME - print "POOL DATASET_ROOT" of an instance, or a reason and
# return 1.
#
# Asked from Incus, not assembled from a pool name in config: the instance's
# root device names the storage pool, the pool's zfs.pool_name names the ZFS
# dataset Incus keeps it under ("tank", "tank/incus", ...). Anything but the
# zfs driver is refused by name. Default project only.
zk2_storage() {
    local pool driver root
    pool=$(incus query "/1.0/instances/$1" </dev/null 2>/dev/null | jq -r '.expanded_devices.root.pool // empty')
    [ -n "$pool" ] || { echo "no root disk pool"; return 1; }
    read -r driver root < <(incus query "/1.0/storage-pools/${pool}" </dev/null 2>/dev/null \
        | jq -r '[.driver, (.config["zfs.pool_name"] // .name)] | @tsv' | tr '\t' ' ') || true
    [ "$driver" = zfs ] || { echo "storage pool ${pool} uses ${driver:-?}, only zfs is supported"; return 1; }
    echo "$pool $root"
}

# borg settings from zk2-env, exported for borg. An empty BORG_RSH is not
# exported: borg would take it as an empty ssh command.
zk2_borg_env() {
    zk2_load_env BORG_REPO BORG_PASSPHRASE
    export BORG_REPO BORG_PASSPHRASE
    [ -z "${BORG_RSH:-}" ] || export BORG_RSH
}

# Wait for systemd inside an instance to finish booting. The STATE counts,
# not the exit code: is-system-running exits non-zero on "degraded" - booted,
# with a failed unit - and waiting for zero would sit out the whole timeout
# on an instance that was ready in seconds.
zk2_ct_wait_systemd() {
    local ct=$1 tries=${2:-30} i=0
    while [ "$i" -lt "$tries" ]; do
        case "$(incus exec "$ct" -- systemctl is-system-running </dev/null 2>/dev/null || true)" in
            running|degraded) return 0 ;;
        esac
        i=$(( i + 1 )); sleep 2
    done
    return 1
}

# zk2_ct_config_apply NAME FILE [NAME_IN_FILE]
#
# Give a restored instance the configuration of its source: limits, swap,
# autostart, nesting, root size. All of it lives in the Incus database, not in
# the instance's root; an archive carries the root, and an instance created
# from a base image comes up with the image's settings - the memory of the
# whole node and a root the size of the pool.
#
# FILE is Incus JSON: one instance (incus query /1.0/instances/NAME) or a list
# (instances.json from the host backup). NAME_IN_FILE is for a probe restored
# under another name.
#
# Not carried over: volatile.* and image.* (Incus keeps them: MAC, UUID, the
# image record - foreign values would break both), profiles (the instance
# gets default), eth0 (the address comes from the restore map), other devices
# (paths and addresses may differ at the new place - listed, not copied).
zk2_ct_config_apply() {
    local ct=$1 src=$2 want=${3:-$1} inst kv size extra n=0 rc=0
    inst=$(jq -c --arg n "$want" 'if type == "array" then (.[] | select(.name == $n)) else . end' "$src" 2>/dev/null | head -1)
    [ -n "$inst" ] || { zk2_warn "  no configuration of ${want} in ${src} - default limits stay"; return 1; }

    # One key at a time: a key the local Incus does not accept would fail a
    # combined call and hide which one it was. NUL separated: values can be
    # multi-line (raw.lxc, cloud-init.*).
    while IFS= read -r -d '' kv; do
        if incus config set "$ct" "$kv" </dev/null 2>/dev/null; then
            n=$(( n + 1 ))
        else
            zk2_warn "  key ${kv%%=*} not accepted"; rc=1
        fi
    done < <(jq -j '.config // {} | to_entries[] | select(.key | test("^(volatile|image)\\.") | not)
                    | "\(.key)=\(.value)\u0000"' <<<"$inst")

    # Root size is a device property: override when the device comes from a
    # profile (the usual case), set when the instance has its own.
    size=$(jq -r '.devices.root.size // empty' <<<"$inst")
    if [ -n "$size" ]; then
        incus config device override "$ct" root size="$size" </dev/null >/dev/null 2>&1 \
            || incus config device set "$ct" root size="$size" </dev/null >/dev/null 2>&1 \
            || { zk2_warn "  root size ${size} not set"; rc=1; }
    fi
    zk2_ok "  source configuration: ${n} keys, memory $(jq -r '.config["limits.memory"] // "unlimited"' <<<"$inst"), root ${size:-unlimited}"

    extra=$(jq -r '.devices // {} | keys[]' <<<"$inst" | grep -vxE 'root|eth0' || true)
    [ -z "$extra" ] || zk2_warn "  devices NOT carried over, add them by hand: $(tr '\n' ' ' <<<"$extra")"
    return $rc
}

# --------------------------------------------------------------------------
# IPv4 arithmetic for the instance network (CT_NET, any prefix length)
# --------------------------------------------------------------------------

# Word splitting on dots is the point here.
# shellcheck disable=SC2086
zk2_ip2int() { local IFS=.; set -- $1; echo $(( ($1 << 24) + ($2 << 16) + ($3 << 8) + $4 )); }
zk2_int2ip() { echo "$(( ($1 >> 24) & 255 )).$(( ($1 >> 16) & 255 )).$(( ($1 >> 8) & 255 )).$(( $1 & 255 ))"; }

# zk2_net NET - print "NETWORK_INT BROADCAST_INT PREFIX" for 10.20.0.0/24.
zk2_net() {
    local addr=${1%/*} len=${1#*/} n mask
    [[ "$1" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}/([0-9]|[12][0-9]|3[0-2])$ ]] || return 1
    mask=$(( len == 0 ? 0 : (0xFFFFFFFF << (32 - len)) & 0xFFFFFFFF ))
    n=$(( $(zk2_ip2int "$addr") & mask ))
    echo "$n $(( n | (~mask & 0xFFFFFFFF) )) $len"
}

# zk2_in_net IP NET - true when IP is a host address of NET.
zk2_in_net() {
    local n b i
    read -r n b _ < <(zk2_net "$2") || return 1
    [[ "$1" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || return 1
    i=$(zk2_ip2int "$1")
    [ "$i" -gt "$n" ] && [ "$i" -lt "$b" ]
}

# Defaults derived from node.conf: the bridge holds the first address of the
# instance network unless CT_GATEWAY says otherwise.
zk2_net_defaults() {
    local n
    CT_BRIDGE=${CT_BRIDGE:-incusbr0}
    [ -n "${CT_NET:-}" ] || return 0
    read -r n _ _ < <(zk2_net "$CT_NET") || zk2_die "CT_NET='${CT_NET}' is not a network like 10.20.0.0/24"
    CT_GATEWAY=${CT_GATEWAY:-$(zk2_int2ip $(( n + 1 )))}
}

# zk2_ct_unpin NAME - make an imported COPY safe to start next to its
# original: an export carries the original's MAC addresses
# (volatile.DEV.hwaddr) and fixed IP addresses. Incus refuses ANY config
# change of such a copy while its MAC collides ("MAC address ... already
# defined on another NIC"), so the MACs go first - Incus generates new ones -
# and the addresses after. boot.autostart=false: a copy must not come up by
# itself after a reboot. The result is read back, not trusted from exit codes.
zk2_ct_unpin() {
    local ct=$1 dev left=""
    for dev in $(incus query "/1.0/instances/${ct}" </dev/null | jq -r '.devices // {} | to_entries[] | select(.value.type == "nic") | .key'); do
        incus config unset "$ct" "volatile.${dev}.hwaddr" </dev/null >/dev/null 2>&1 || true
        incus config device unset "$ct" "$dev" ipv4.address </dev/null >/dev/null 2>&1 || true
        incus config device unset "$ct" "$dev" ipv6.address </dev/null >/dev/null 2>&1 || true
        [ -z "$(incus config device get "$ct" "$dev" ipv4.address </dev/null 2>/dev/null)" ] || left+=" ${dev}"
    done
    incus config set "$ct" boot.autostart=false </dev/null
    if [ -n "$left" ]; then
        zk2_err "  ${ct}: fixed address still set on${left} - do not start it next to the original"
        return 1
    fi
    zk2_log "  ${ct}: new MAC, fixed address dropped, boot.autostart=false"
}
