#!/bin/bash
#
# Set up the OpenVPN server in its instance. Runs INSIDE the openvpn instance.
#
# Usage: zk2-vpn-setup --remote PUBLIC_ADDRESS --pool VPN_NET --route CT_NET [--port 1194]
#
#   --remote  the address clients connect to (the node's public address);
#             saved to /etc/openvpn/zk2-vpn.conf for zk2-vpn-add
#   --pool    the client address pool, VPN_NET in node.conf (10.20.100.0/24)
#   --route   the instance network pushed to clients, CT_NET in node.conf
#   --port    UDP port; must match the node's publication/forward.yaml
#
# Idempotent: an existing PKI is kept; server.conf, the firewall and the
# sysctl are rewritten from the arguments. Run it again after changing them.
#
# What it does, in order: packages (apt or dnf), PKI in
# /etc/openvpn/easy-rsa/pki with a CA and a server pair, the service
# directory /etc/openvpn/server (closed, without the CA key), the revocation
# list in an OPEN place, server.conf, IP forwarding, nftables rules, and the
# service openvpn-server@server.
#
# On the node, VPN_NET and VPN_CT_IP (this instance's address) in node.conf
# make zk2-node-build route the pool through this instance - on the node and,
# by DHCP, inside every instance. Without that, VPN clients cannot talk to
# instances, see zk2-node-build.

set -euo pipefail

PORT=1194 REMOTE="" POOL="" ROUTE=""
while [ $# -gt 0 ]; do
    case "$1" in
        --remote) REMOTE=${2:?}; shift 2 ;;
        --pool)   POOL=${2:?}; shift 2 ;;
        --route)  ROUTE=${2:?}; shift 2 ;;
        --port)   PORT=${2:?}; shift 2 ;;
        -h|--help) sed -n '3,25p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) echo "unknown option: $1" >&2; exit 1 ;;
    esac
done
die() { echo "$*" >&2; exit 1; }
[ "$(id -u)" = 0 ] || die "must be run as root"
if [ -z "$REMOTE" ] || [ -z "$POOL" ] || [ -z "$ROUTE" ]; then die "--remote, --pool and --route are required (see --help)"; fi
net_re='^([0-9]{1,3}\.){3}[0-9]{1,3}/([0-9]|[12][0-9]|3[0-2])$'
if ! [[ $POOL =~ $net_re ]] || ! [[ $ROUTE =~ $net_re ]]; then die "--pool and --route take networks like 10.20.100.0/24"; fi

# 10.20.100.0/24 -> "10.20.100.0 255.255.255.0", as OpenVPN wants it.
mask() { local l=${1#*/} m=$(( (0xFFFFFFFF << (32 - ${1#*/})) & 0xFFFFFFFF )); [ "$l" = 0 ] && m=0
         echo "${1%/*} $(( m >> 24 & 255 )).$(( m >> 16 & 255 )).$(( m >> 8 & 255 )).$(( m & 255 ))"; }

PKI=/etc/openvpn/easy-rsa/pki
SRV=/etc/openvpn/server
CRL=/etc/openvpn/crl.pem

echo "== packages"
if command -v apt-get >/dev/null; then
    DEBIAN_FRONTEND=noninteractive apt-get install -y -qq openvpn easy-rsa nftables openssl >/dev/null
elif command -v dnf >/dev/null; then
    dnf -y -q install epel-release && dnf -y -q install openvpn easy-rsa nftables openssl
else
    die "neither apt-get nor dnf"
fi
# easyrsa: in PATH, or where Debian (/usr/share/easy-rsa) or the RHEL family
# (/usr/share/easy-rsa/3) put it.
EASYRSA=""
for c in "$(command -v easyrsa || true)" /usr/share/easy-rsa/easyrsa /usr/share/easy-rsa/3/easyrsa; do
    if [ -n "$c" ] && [ -x "$c" ]; then EASYRSA=$c; break; fi
done
[ -x "$EASYRSA" ] || die "easyrsa not found"
# The group the server drops to: nogroup on Debian, nobody on the RHEL family.
GROUP=nobody; getent group nogroup >/dev/null && GROUP=nogroup

echo "== PKI in ${PKI}"
# The PKI lives under /etc, NOT inside the easy-rsa package directory, where
# a package update could remove it. One PKI per node: a CA shared by two
# servers gives clients colliding serial numbers, and a revocation on one
# node means nothing obvious on the other.
export EASYRSA_PKI=$PKI EASYRSA_BATCH=1
mkdir -p /etc/openvpn/easy-rsa
if [ ! -f "${PKI}/ca.crt" ]; then
    "$EASYRSA" init-pki
    "$EASYRSA" --req-cn="zk2 VPN CA $(hostname)" build-ca nopass
    "$EASYRSA" build-server-full server nopass
    "$EASYRSA" gen-crl
    openvpn --genkey secret "${PKI}/ta.key"
else
    echo "   exists, kept"
fi

echo "== service directory ${SRV}"
# Closed, and WITHOUT the CA key: the key that signs clients does not belong
# next to a network service.
install -d -m 700 "$SRV" "${SRV}/issued" "${SRV}/private"
install -m 600 "${PKI}/ca.crt" "${SRV}/ca.crt"
install -m 600 "${PKI}/issued/server.crt" "${SRV}/issued/server.crt"
install -m 600 "${PKI}/private/server.key" "${SRV}/private/server.key"
install -m 600 "${PKI}/ta.key" "${SRV}/ta.key"
# The revocation list in an OPEN directory, mode 644. The server re-reads it
# on every connection AFTER dropping to nobody; inside the closed service
# directory it could not even stat it, would keep the list loaded at start,
# and revocations would silently not work until a restart.
install -m 644 "${PKI}/crl.pem" "$CRL"

echo "== ${SRV}/server.conf"
cat > "${SRV}/server.conf" <<EOF
# Written by zk2-vpn-setup; run it again rather than editing by hand.
# Paths are relative: openvpn-server@server runs in ${SRV}.
port ${PORT}
proto udp
dev tun
topology subnet

ca ca.crt
cert issued/server.crt
key private/server.key
# No DH parameters: ECDHE key exchange (OpenVPN 2.4+) does not use them,
# and generating them takes minutes.
dh none
tls-auth ta.key 0
crl-verify ${CRL}

server $(mask "$POOL")
ifconfig-pool-persist ipp.txt
push "route $(mask "$ROUTE")"

# Split tunnel on purpose: clients reach the instance network through the
# tunnel and everything else directly. Uncomment to send all their traffic
# through the node.
#push "redirect-gateway def1"

explicit-exit-notify 1
keepalive 10 120
user nobody
group ${GROUP}
persist-key
persist-tun

# No compression. If it is ever turned on here, clients need it too:
# zk2-vpn-add copies the setting into client configs.
allow-compression no
data-ciphers AES-256-GCM:AES-128-GCM:CHACHA20-POLY1305

status /var/log/openvpn-status.log 60
log-append /var/log/openvpn.log
verb 3
EOF
printf 'REMOTE_HOST=%s\n' "$REMOTE" > /etc/openvpn/zk2-vpn.conf

echo "== forwarding and firewall"
echo 'net.ipv4.ip_forward = 1' > /etc/sysctl.d/90-zk2-vpn.conf
sysctl -q -w net.ipv4.ip_forward=1
# Into the instance network clients go with their OWN addresses (instances
# see the real client in their logs; the node routes replies back to the
# pool through this instance). Anywhere else they are masqueraded - a
# private pool address leaving the node would never come back. The order of
# the two rules is the point.
cat > /etc/nftables.conf <<EOF
#!/usr/sbin/nft -f
# Written by zk2-vpn-setup. This instance has no other tables.
flush ruleset
table inet zk2vpn {
    chain postrouting {
        type nat hook postrouting priority srcnat;
        ip saddr ${POOL} ip daddr ${ROUTE} return
        ip saddr ${POOL} oifname "eth0" masquerade
    }
}
EOF
nft -f /etc/nftables.conf
systemctl enable nftables >/dev/null 2>&1 || true

echo "== service"
systemctl enable openvpn-server@server >/dev/null 2>&1
systemctl restart openvpn-server@server
sleep 2
systemctl is-active openvpn-server@server
echo
echo "done. Clients: zk2-vpn-add NAME; overview: zk2-vpn-show"
echo "On the node: VPN_NET=${POOL} and VPN_CT_IP=<this instance's address> in node.conf,"
echo "then zk2-deploy and zk2-node-build; publish UDP ${PORT} to this instance."
