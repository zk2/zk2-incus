#!/bin/bash
#
# Revoke an OpenVPN client: revoke in the PKI, reissue the revocation list,
# remove the generated config. Runs INSIDE the openvpn instance.
#
# Usage: zk2-vpn-revoke [--force] NAME
#
# REVOKING IS NOT DELETING FILES. The server checks a client by the CA's
# signature, not against its own copies of certificates: the client holds
# its key and certificate, and after deleting files on the server it keeps
# connecting until the certificate expires - for years. Deleting from the PKI
# directories also breaks easy-rsa's index, after which there is nothing to
# revoke with. A real revocation is three things: revoke in the index, a
# reissued crl.pem, and crl-verify in server.conf - this script does the
# first two and fails loudly when the third is missing.
#
# The certificate the server runs with RIGHT NOW is refused: in a list it
# looks like any client's, and revoking it leaves the running service with a
# revoked identity. --force goes on regardless.
#
# An open session of a revoked client lives until it reconnects; to cut it
# at once, restart openvpn-server@server (which drops every client).

set -euo pipefail

SRV=/etc/openvpn/server
CRL=/etc/openvpn/crl.pem
OUT_DIR=${OUT_DIR:-/root/vpn_configs}
export EASYRSA_PKI=/etc/openvpn/easy-rsa/pki EASYRSA_BATCH=1
die() { echo "$*" >&2; exit 1; }

FORCE=0
[ "${1:-}" = --force ] && { FORCE=1; shift; }
NAME=${1:-}
[ -n "$NAME" ] || die "usage: $(basename "$0") [--force] NAME"
case "$NAME" in *[!A-Za-z0-9._-]*) die "invalid name" ;; esac
# easyrsa: in PATH, or where Debian (/usr/share/easy-rsa) or the RHEL family
# (/usr/share/easy-rsa/3) put it.
EASYRSA=""
for c in "$(command -v easyrsa || true)" /usr/share/easy-rsa/easyrsa /usr/share/easy-rsa/3/easyrsa; do
    if [ -n "$c" ] && [ -x "$c" ]; then EASYRSA=$c; break; fi
done
[ -x "$EASYRSA" ] || die "easyrsa not found"
[ -f "${EASYRSA_PKI}/issued/${NAME}.crt" ] || die "no issued certificate ${NAME} in ${EASYRSA_PKI}"

srv_cert=$(awk '$1 == "cert" { print $2; exit }' "${SRV}/server.conf" 2>/dev/null || true)
case "$srv_cert" in ""|/*) ;; *) srv_cert="${SRV}/${srv_cert}" ;; esac
if [ -n "$srv_cert" ] && [ -r "$srv_cert" ]; then
    s1=$(openssl x509 -in "$srv_cert" -noout -serial | cut -d= -f2)
    s2=$(openssl x509 -in "${EASYRSA_PKI}/issued/${NAME}.crt" -noout -serial | cut -d= -f2)
    if [ "$s1" = "$s2" ]; then
        if [ "$FORCE" = 0 ]; then
            echo "REFUSED: ${NAME} is the certificate the server runs with (${srv_cert})." >&2
            echo "To replace it: issue a new server pair, point server.conf at it, restart," >&2
            echo "check that clients are back - and only then revoke the old one." >&2
            exit 1
        fi
        echo "WARNING: revoking the server's CURRENT certificate (--force)."
    fi
fi

printf 'Revoke %s? This cannot be undone. [y/N]: ' "$NAME"
read -r answer
case "$answer" in y|Y|yes) ;; *) echo "cancelled"; exit 0 ;; esac

"$EASYRSA" revoke "$NAME"
"$EASYRSA" gen-crl
# 644: the server re-reads the list on every connection as nobody. A list it
# cannot read cuts off not the revoked client but everyone.
install -m 644 "${EASYRSA_PKI}/crl.pem" "$CRL"
rm -f "${OUT_DIR}/${NAME}.ovpn"
echo "revoked: ${NAME}"
echo "revocation list valid until $(openssl crl -in "$CRL" -noout -nextupdate | cut -d= -f2)"
echo "(an expired list makes OpenVPN refuse EVERY client; zk2-health warns in advance)"

if ! grep -qE '^[[:space:]]*crl-verify' "${SRV}/server.conf"; then
    echo "WARNING: no crl-verify in ${SRV}/server.conf - the revoked client still gets in." >&2
    echo "Add 'crl-verify ${CRL}' and restart openvpn-server@server." >&2
    exit 1
fi
